# Copiez ce fichier en ".env" (même dossier) et renseignez vos valeurs.
# Le fichier ".env" n'est jamais commité (voir .gitignore).
#
# IMPORTANT : si une valeur contient un caractère '#' (fréquent dans un mot de passe),
# encadrez-la de guillemets, sinon tout ce qui suit le '#' est silencieusement coupé
# (traité comme un commentaire). Ex : DB_PASSWORD="Mot#DePasse123"

# Connexion à votre serveur SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=FlotteMaintenance
DB_USER=flotte_app
DB_PASSWORD="ChangezMoi!"

# true/false — voir README pour le détail de ces deux options
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Secret utilisé pour signer les tokens de connexion (mettre une valeur longue et aléatoire en prod)
JWT_SECRET=changez-cette-valeur-en-production

# Port d'écoute de l'API
PORT=4000

# Optionnel : identifiants du compte admin créé par "npm run seed"
# SEED_ADMIN_EMAIL=cklein@navigfrance.com
# SEED_ADMIN_PASSWORD=admin1234

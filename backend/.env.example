# Copiez ce fichier en ".env" (même dossier) et renseignez vos valeurs.
# Le fichier ".env" n'est jamais commité (voir .gitignore).
#
# IMPORTANT : si une valeur contient un caractère '#' (fréquent dans un mot de passe),
# encadrez-la de guillemets, sinon tout ce qui suit le '#' est silencieusement coupé
# (traité comme un commentaire). Ex : DB_PASSWORD="Mot#DePasse123"

# Connexion à votre serveur SQL Server
#
# IMPORTANT si vous utilisez une instance nommée (ex. SQL Server Express, souvent installé en
# "NOMPC\SQLEXPRESS") : NE mettez PAS "\SQLEXPRESS" dans DB_SERVER. Le pilote découperait
# alors le nom d'instance et ignorerait DB_PORT pour tenter de le résoudre via le service
# "SQL Server Browser" (port UDP 1434) — qui échoue souvent avec l'erreur
# "Port for SQLEXPRESS not found in ..." si ce service n'est pas démarré/accessible.
# Solution recommandée : donnez à SQLEXPRESS un port TCP fixe (SQL Server Configuration
# Manager > Protocols for SQLEXPRESS > TCP/IP > IP Addresses > IPAll > TCP Port, ex. 1433,
# en vidant "TCP Dynamic Ports"), redémarrez le service SQL Server, puis renseignez ici le nom
# de la machine SANS "\SQLEXPRESS" et ce port fixe.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=FlotteMaintenance
DB_USER=flotte_app
DB_PASSWORD="ChangezMoi!"

# true/false — voir README pour le détail de ces deux options
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Secret utilisé pour signer les tokens de connexion (mettre une valeur longue et aléatoire en prod)
JWT_SECRET=changez-cette-valeur-en-production

# Port d'écoute de l'API
PORT=4000

# Optionnel : identifiants du compte admin créé par "npm run seed"
# SEED_ADMIN_EMAIL=cklein@navigfrance.com
# SEED_ADMIN_PASSWORD=admin1234
